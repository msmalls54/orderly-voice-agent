# The safe local default uses the mock provider. No credential is needed.
SMS_PROVIDER=mock
APP_MODE=mock
LIVE_SMS_ENABLED=false
SMS_OUTBOUND_VERIFIED=false
VOICE_PURCHASE_VERIFIED=false
MIN_VOICE_CONFIRMATION_CONFIDENCE=0
CHECKOUT_CONFIRM_TTL_SECONDS=180
ORDER_TOTAL_LIMIT_CENTS=5000
PURCHASE_ENABLED=false
DOORDASH_ACCOUNT_CONNECTED_VERIFIED=false
DOORDASH_CLI_PATH=
DD_CLI_ACCESS_TOKEN=
# Set only after the exact cart has been created and independently validated.
DOORDASH_DEMO_CART_UUID=
# Optional schedule-ahead time. Always use an offset-bearing ISO-8601 value;
# it is normalized to UTC and bound to preview, approval, and submit.
DOORDASH_SCHEDULED_TIME=
# Generate a fresh UUID for each separately authorized live purchase run.
# Never reuse or delete an earlier run ID; its consumed guard is durable.
DOORDASH_PURCHASE_RUN_ID=

# New AgentPhone build only. Never reuse the Grandpa Food agent ID.
AGENTPHONE_API_BASE_URL=https://api.agentphone.ai/v1
AGENTPHONE_API_KEY=
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
AGENTPHONE_PHONE_NUMBER=
AGENTPHONE_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=

# These gates stay false until a separate agent/number exists and a specifically
# authorized supervised test is beginning.
AGENTPHONE_AGENT_SEPARATION_CONFIRMED=false
AGENTPHONE_WEBHOOK_SETUP_ENABLED=false
AGENTPHONE_WEBHOOK_REMOTE_VERIFIED=false

# Comma-separated E.164 numbers. ADMIN_PHONE must also appear in this list.
ALLOWED_PHONES=
ADMIN_PHONE=

# Generate a 32-byte base64 key and a separate random 32+ character hash key.
# Store production values only in the deployment platform's encrypted secrets.
DATA_ENCRYPTION_KEY=
PII_HASH_KEY=

PORT=8787
DATABASE_PATH=./data/chudbot-sms.db
WEBHOOK_MAX_AGE_SECONDS=300
MAX_REQUEST_BODY_BYTES=32768
MAX_SMS_LENGTH=800
MAX_SMS_PER_10_MINUTES=12
MAX_QUEUE_AGE_SECONDS=300
MAX_INBOUND_ATTEMPTS=3
MAX_OUTBOUND_ATTEMPTS=5
WORKER_POLL_MS=1000
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# Optional integrations. Live DoorDash remains unavailable until every gate above is verified.
LIVE_DOORDASH_READ_ONLY=false
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_LLM_MODEL=gemini-3.7-flash
VOICE_SESSION_LIMIT=6
VOICE_SESSION_WINDOW_SECONDS=600
LINKUP_API_KEY=
OPENAI_API_KEY=
